{
  "name": "dsh-batch-tasks",
  "version": "0.1.37",
  "description": "DeepSeek Harness 原生批量任务插件：选择 Agent、独立任务目录、SDK 会话投递与停止管理",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-batch": "./bin/dsh-batch.mjs"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "batch",
    "queue"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node bin/dsh-batch.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:ui": "node tests/ui.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=22.19"
  }
}
